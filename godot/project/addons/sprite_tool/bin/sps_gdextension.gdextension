[configuration]

entry_symbol = "sps_gdextension_library_init"
compatibility_minimum = "4.1"
# 热重载开关（仅 debug 构建生效）。注：4.6.2 编辑器模式崩溃与 reloadable 无关
# （是 EditorHelp 扩展文档生成 bug，见 SKILL.md §7），此值保持 false 仅因暂不需要热重载。
reloadable = false

[libraries]

macos.debug = "res://addons/sprite_tool/bin/macos/sps_gdextension.macos.template_debug.arm64.dylib"
macos.release = "res://addons/sprite_tool/bin/macos/sps_gdextension.macos.template_release.arm64.dylib"
windows.debug.x86_64 = "res://addons/sprite_tool/bin/windows/sps_gdextension.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/sprite_tool/bin/windows/sps_gdextension.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/sprite_tool/bin/linux/sps_gdextension.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/sprite_tool/bin/linux/sps_gdextension.linux.template_release.x86_64.so"
